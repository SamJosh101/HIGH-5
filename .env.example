# HIGH 5 environment configuration.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Django ---
# Generate a key with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database (MySQL 8.x is the official database) ---
DB_ENGINE=mysql
DB_NAME=high5_db
DB_USER=high5_user
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_high5_db

# --- Email (verification codes and password resets) ---
# Development: the console backend prints every email (with the code) in the runserver terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=HIGH 5 <no-reply@high5.local>
# Real inboxes (Gmail): set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and fill these in.
# EMAIL_HOST_PASSWORD is a Gmail *App Password* (16 letters), not your normal Gmail password.
# See docs/EMAIL_VERIFICATION.md. Keep real values in .env only.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10

# --- Locale & business rules ---
TIME_ZONE=Africa/Lagos
BOOKING_CANCELLATION_CUTOFF_HOURS=24
CURRENCY_SYMBOL=₦

# Cache-busting for CSS/JS links. Empty = automatic in development; set per release in production.
ASSET_VERSION=
