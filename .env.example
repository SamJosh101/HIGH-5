# HIGH 5 environment configuration.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Django ---
# Generate a key with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database (MySQL 8.x is the official database) ---
DB_ENGINE=mysql
DB_NAME=high5_db
DB_USER=high5_user
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_high5_db

# --- Email (console backend prints password-reset emails in the terminal) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=HIGH 5 <no-reply@high5.local>

# --- Locale & business rules ---
TIME_ZONE=Africa/Lagos
BOOKING_CANCELLATION_CUTOFF_HOURS=24
CURRENCY_SYMBOL=₦

# Cache-busting for CSS/JS links. Empty = automatic in development; set per release in production.
ASSET_VERSION=

# --- Test accounts for `python manage.py seed_demo` (development only) ---
# Choose your own passwords (at least 8 characters, not common, not only numbers).
# They are never written in the code; seed_demo reads them from here.
DEMO_ADMIN_PASSWORD=
DEMO_PASSENGER_PASSWORD=
